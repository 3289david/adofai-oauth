generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  CREATOR
  MODERATOR
  ADMIN
}

/// Compatibility with ADOFAI.VERSE `User` when sharing the same DATABASE_URL.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole @default(PLAYER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authCodes AuthCode[]
}

/// OAuth 2.0 client (public = PKCE-only, or confidential with secret).
model OAuthClient {
  id              String   @id @default(cuid())
  clientId        String   @unique
  clientSecretHash String? // bcrypt hash; null for public clients
  name            String
  redirectUris    String[]
  isPublic        Boolean  @default(true) // PKCE required when true
  createdAt       DateTime @default(now())

  authCodes AuthCode[]
}

model AuthCode {
  id                     String   @id @default(cuid())
  code                   String   @unique
  clientId               String
  client                 OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri            String
  codeChallenge          String
  codeChallengeMethod    String   @default("S256")
  scope                  String   @default("openid profile email")
  expiresAt              DateTime
  usedAt                 DateTime?
  createdAt              DateTime @default(now())

  @@index([code])
  @@index([expiresAt])
}
