# =============================================================================
# ADOFAI Auth (IdP) — combined reference (everything in ONE file — dev-only).
# Prefer split commits: `.env.public.example` → `.env`, `.env.local.example` → `.env.local`
# Deploy / hosts: developer hub lives at https://dev.adofai.net (middleware → `/dev`).
# Repo: https://github.com/3289david/adofai-oauth
# =============================================================================

# PostgreSQL — use the SAME database as ADOFAI.NET if User rows must match OAuth "sub"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/adofai_community"

# Issuer URL (no trailing slash). Used in JWT issuer claim + discovery document + email links
OAUTH_ISSUER="https://auth.adofai.net"

# Duplicate for any client/SSR that reads public config (optional)
NEXT_PUBLIC_AUTH_ISSUER="https://auth.adofai.net"

# Legacy alias read by oauth-config fallback (optional)
# NEXT_PUBLIC_AUTH_URL="https://auth.adofai.net"

# Signs: (1) browser session cookie on IdP login, (2) OAuth access_token JWTs — long random, rotate with care
JWT_SECRET=""

# -----------------------------------------------------------------------------
# Email — Resend (https://resend.com) — verification / transactional from IdP screens
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM="ADOFAI Auth <onboarding@resend.dev>"

# -----------------------------------------------------------------------------
# Cloudflare Turnstile — human verification on /login and /register
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# -----------------------------------------------------------------------------
# prisma/seed.ts — optional bootstrap user + OAuth clients
# -----------------------------------------------------------------------------
# SEED_USER_PASSWORD="change-me-before-production"

# -----------------------------------------------------------------------------
# Node (set by hosting, not usually in .env)
# -----------------------------------------------------------------------------
# NODE_ENV=production
