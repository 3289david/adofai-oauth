# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"

# Must match deployment URL (no trailing slash)
OAUTH_ISSUER="https://auth.adofai.net"

# Signs IdP session cookies and OAuth access tokens (HS256) — use a long random value
JWT_SECRET=""

# Optional: same as OAUTH_ISSUER if you read it in the browser
# NEXT_PUBLIC_AUTH_URL="https://auth.adofai.net"

# Seed script (prisma/seed.ts) default password for demo user
# SEED_USER_PASSWORD="change-me-now!"

# Resend — email verification (matches ADOFAI.NET flow)
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"

# Turnstile — same as main site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
